<!DOCTYPE html>
<html lang="zh-TW">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jason AI Lab</title>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #0b0c10;
            --surface-color: rgba(255, 255, 255, 0.05);
            --primary-accent: #66fcf1;
            --secondary-accent: #45a29e;
            --text-main: #ffffff;
            --text-muted: #c5c6c7;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Outfit', 'Microsoft JhengHei', sans-serif;
            background: linear-gradient(135deg, #0b0c10 0%, #1f2833 100%);
            color: var(--text-main);
            min-height: 100vh;
            overflow-x: hidden;
        }

        /* Header & Navigation */
        header {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            padding: 20px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(11, 12, 16, 0.6);
            backdrop-filter: blur(15px);
            z-index: 1000;
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .logo-container {
            display: flex;
            align-items: center;
            gap: 15px;
            cursor: pointer;
        }

        .logo-img {
            height: 50px;
            width: auto;
            border-radius: 8px;
            box-shadow: 0 0 15px rgba(102, 252, 241, 0.3);
            transition: transform 0.3s ease;
        }

        .logo-container:hover .logo-img {
            transform: scale(1.05);
            box-shadow: 0 0 25px rgba(102, 252, 241, 0.5);
        }

        .logo-text {
            font-size: 1.5rem;
            font-weight: 800;
            letter-spacing: 2px;
            background: linear-gradient(45deg, var(--primary-accent), #b2f5ea);
            -webkit-background-clip: text;
            background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        /* Hero Section */
        .hero {
            padding: 150px 50px 80px;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .hero h1 {
            font-size: 3.5rem;
            font-weight: 800;
            margin-bottom: 20px;
            line-height: 1.2;
            animation: fadeInDown 1s ease-out;
        }

        .hero p {
            font-size: 1.2rem;
            color: var(--text-muted);
            margin-bottom: 40px;
            animation: fadeInUp 1s ease-out 0.2s both;
            line-height: 1.6;
        }

        /* Gallery Grid */
        .gallery-container {
            padding: 40px 50px 100px;
            max-width: 1400px;
            margin: 0 auto;
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));
            gap: 30px;
            animation: fadeIn 1.5s ease-out 0.4s both;
        }

        .gallery-item {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            background: var(--surface-color);
            aspect-ratio: 4/3;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275), box-shadow 0.4s ease;
            cursor: pointer;
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .gallery-item:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(102, 252, 241, 0.2);
            border-color: rgba(102, 252, 241, 0.3);
        }

        .gallery-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .gallery-item:hover img {
            transform: scale(1.08);
            /* Fallback scale */
        }

        .item-overlay {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            padding: 40px 20px 20px;
            /* 讓底部漸層更滑順，避免文字被遮擋 */
            background: linear-gradient(to top, rgba(11, 12, 16, 0.95) 0%, rgba(11, 12, 16, 0.7) 40%, transparent 100%);
            color: white;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
            transition: padding-bottom 0.4s cubic-bezier(0.19, 1, 0.22, 1);
        }

        .gallery-item:hover .item-overlay {
            /* 懸停時文字微微上浮，增加互動感 */
            padding-bottom: 25px;
        }

        .item-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: var(--text-main);
        }

        .item-category {
            font-size: 0.85rem;
            color: var(--primary-accent);
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
        }

        /* Animations */
        @keyframes fadeInDown {
            from {
                opacity: 0;
                transform: translateY(-30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes fadeIn {
            from {
                opacity: 0;
            }

            to {
                opacity: 1;
            }
        }

        /* Responsive */
        @media (max-width: 768px) {
            header {
                padding: 15px 20px;
            }

            .hero {
                padding: 120px 20px 60px;
            }

            .hero h1 {
                font-size: 2.5rem;
            }

            .gallery-container {
                padding: 20px;
                grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
                gap: 20px;
            }
        }
    </style>
</head>

<body>

    <header>
        <div class="logo-container">
            <img src="./assets/jasoninfo_logo.png" alt="JasonInfo Logo" class="logo-img">
            <div class="logo-text">Jason AI Lab</div>
        </div>
        <nav>
            <!-- 可在此擴充選單，例如：關於我、聯絡資訊等 -->
        </nav>
    </header>

    <section class="hero">
        <h1>探索設計與科技的邊界</h1>
        <p>歡迎來到我的數位作品集展廳，這裡收錄了從概念設計、行動應用到網頁系統的精選成果，融合現代美學與流暢且創新的互動體驗。</p>
    </section>

    <main class="gallery-container">

        <!-- FlowBoard Kanban -->
        <article class="gallery-item" onclick="window.open('./Portfolio/Kanban/index.html', '_blank')">
            <img src="./assets/portfolio_kanban.png" alt="FlowBoard Team Kanban"
                onerror="this.src='https://plus.unsplash.com/premium_photo-1681487870238-4a2dfddc6bcb?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80'">
            <div class="item-overlay">
                <span class="item-category">Web App / Productivity</span>
                <h3 class="item-title">FlowBoard 團隊看板</h3>
            </div>
        </article>

        <!-- MBTI -->
        <article class="gallery-item" onclick="window.open('./Portfolio/MBTI/index.html', '_blank')">
            <img src="./assets/portfolio_mbti.png" alt="MBTI Personality Test">
            <div class="item-overlay">
                <span class="item-category">Web App / Psychology</span>
                <h3 class="item-title">MBTI 專業性格測驗</h3>
            </div>
        </article>

        <!-- New Employee Questionnaire -->
        <article class="gallery-item" onclick="window.open('./Portfolio/NewEmployee/index.html', '_blank')">
            <img src="./assets/portfolio_new_employee.png" alt="New Employee Questionnaire">
            <div class="item-overlay">
                <span class="item-category">Web App / Onboarding</span>
                <h3 class="item-title">新進人員說明書測驗</h3>
            </div>
        </article>

        <!-- 情緒管理小幫手 -->
        <article class="gallery-item" onclick="window.open('./Portfolio/EmotionalHelper/index.html', '_blank')">
            <img src="./assets/portfolio_emotional_helper.png" alt="Emotional Helper">
            <div class="item-overlay">
                <span class="item-category">Web App / Wellness</span>
                <h3 class="item-title">情緒管理小幫手</h3>
            </div>
        </article>

    </main>

    <script>
        // 加入動態游標跟隨視差效果
        document.querySelectorAll('.gallery-item').forEach(item => {
            const img = item.querySelector('img');

            item.addEventListener('mousemove', e => {
                const rect = item.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;

                // 計算位移比例 (越往邊緣位移越大)
                const moveX = (x - rect.width / 2) / rect.width * 15;
                const moveY = (y - rect.height / 2) / rect.height * 15;

                img.style.transform = `scale(1.1) translate(${-moveX}px, ${-moveY}px)`;
            });

            item.addEventListener('mouseleave', () => {
                img.style.transform = `scale(1) translate(0px, 0px)`;
            });
        });

        // 頁首捲動模糊背景效果
        window.addEventListener('scroll', () => {
            const header = document.querySelector('header');
            if (window.scrollY > 50) {
                header.style.background = 'rgba(11, 12, 16, 0.9)';
                header.style.boxShadow = '0 4px 30px rgba(0, 0, 0, 0.5)';
            } else {
                header.style.background = 'rgba(11, 12, 16, 0.6)';
                header.style.boxShadow = 'none';
            }
        });
    </script>
</body>

</html>